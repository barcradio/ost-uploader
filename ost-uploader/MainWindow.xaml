<Window x:Class="ost_uploader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ost_uploader"
        mc:Ignorable="d"
        Title="OST-Uploader" Width="820" Height="520" SizeToContent="WidthAndHeight">
    <Window.Resources>
        <Style x:Key="StandardButton" TargetType="Button">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <StackPanel Orientation="Vertical">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,4" >
                <Label Content="Event File:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox Name="eventFile_textBox" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" Text="" Margin="10,0,0,0" MinWidth="480"/>
                <Button Name="browseEvent_Button" Style="{StaticResource StandardButton}" Content="Browse Event File" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Click="browseEvent_Button_Click"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4,0,4">
                <Label Content="Email:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox x:Name="userEmail_TextBox" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" Width="120" Height="18" TextChanged="userEmail_TextBox_TextChanged"/>
                <Label Content="Password:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                <PasswordBox x:Name="password_TextBox" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Width="120" Height="18" PasswordChanged="password_TextBox_PasswordChanged"/>
                <Button x:Name="loginButton" Content="Login"
                        Style="{StaticResource StandardButton}"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=passwordBox}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Click="authLogin_Click" />
                <CheckBox x:Name="saveToken_CheckBox" Content="Save credentials" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Securely save the authentication token for future sessions" />
                <Label Name="authStatus_Label" Content="Not Authenticated" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip=""/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,4" >
                <Label Content="Select CSV File:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox Name="fileName_textBox" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" Text="" Margin="10,0,0,0" MinWidth="240"/>
                <Button Name="browse_Button" Style="{StaticResource StandardButton}" Content="Load File" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Click="browse_Button_Click"/>
                <Button Name="upload_Button" Style="{StaticResource StandardButton}" Content="Upload Data" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,10,0" Click="upload_Button_Click"/>
            </StackPanel>
        </Grid>
        <Rectangle Fill="#FF007ACC" Height="2"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,0">
                <TextBox Name="event_textBox" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" Text="" Margin="10,0,0,0" Width="120"/>
                <TextBox Name="station_textBox" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" Text="" Margin="10,0,0,0" Width="120"/>
                <TextBox Name="exportType_textBox" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" Text="" Margin="10,0,0,0" Width="120"/>
                <Label Name="recordsLoaded_Label" Content="Records Loaded: 0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            <DataGrid x:Name="csvDataGrid" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" Height="280" VerticalAlignment="Top" AutoGeneratingColumn="csvDataGrid_AutoGeneratingColumn">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                <Setter Property="Background" Value="#FFF7E29B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Grid>
        <StatusBar Name="statusBar" Height="30" VerticalAlignment="Bottom" >
            <Label Content="OST Site:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
            <ComboBox x:Name="siteComboBox" Width="100" SelectedIndex="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" SelectionChanged="siteComboBox_SelectionChanged" IsEnabled="False">
                <ComboBoxItem>Production</ComboBoxItem>
                <ComboBoxItem>Staging</ComboBoxItem>
            </ComboBox>
            <Label x:Name="event_Label" Content="OST Event"/>
            <TextBox x:Name="ostEvent_TextBox" TextWrapping="Wrap" Text="{Binding OSTEventName, UpdateSourceTrigger=PropertyChanged}" Width="150" IsEnabled="False"/>
            <Separator Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Width="1"/>
            <Label x:Name="status_Label" Content="Status"/>
            <TextBox x:Name="status_TextBox" TextWrapping="Wrap" Text="{Binding StatusMessage, UpdateSourceTrigger=PropertyChanged}" Width="320" IsEnabled="False"/>
        </StatusBar>
    </StackPanel>
</Window>
